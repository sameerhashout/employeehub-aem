<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/employeehub/settings/wcm/templates/employee-landing-template"
        jcr:primaryType="cq:PageContent"
        jcr:title="Events"
        sling:resourceType="employeehub/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="wcm/foundation/components/responsivegrid">
            <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="employeehub/components/header"
                logoText="ABC Employee Hub">
                <navigation
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="employeehub/components/navigation"/>
            </header>
            <hero
                jcr:primaryType="nt:unstructured"
                sling:resourceType="employeehub/components/hero"
                badge="Company Events"
                title="Employee Hub Events"
                subtitle="Stay up to date with everything happening across ABC Corporation"/>
            <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="wcm/foundation/components/responsivegrid">
                <countdown
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="employeehub/components/countdown"
                    heading="Next Company Event In"
                    targetDate="{Date}2026-12-31T18:30:00.000+05:30"/>
                <eventscarousel
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="employeehub/components/eventscarousel"
                    heading="Upcoming Events">
                    <events jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            title="Global Hackathon 2026"
                            description="Seventy-two hours of non-stop building where cross-functional squads race to ship bold prototypes, guided by senior mentors and competing for a prize pool."
                            eventDate="{Date}2026-11-20T09:00:00.000+05:30"
                            cq:tags="[employeehub:event-type/new,employeehub:event-type/marquee]"/>
                        <item1
                            jcr:primaryType="nt:unstructured"
                            title="Leadership AMA Fireside"
                            description="An open, unscripted fireside chat where the executive team answers your toughest questions on strategy, growth, and the road ahead."
                            eventDate="{Date}2026-12-10T16:00:00.000+05:30"
                            cq:tags="[employeehub:event-type/new]"/>
                        <item2
                            jcr:primaryType="nt:unstructured"
                            title="Monsoon Sports League 2025"
                            description="Highlights from last season's inter-department sports league — cricket, football, and the nail-biting badminton finals."
                            eventDate="{Date}2025-07-18T08:00:00.000+05:30"
                            cq:tags="[employeehub:event-type/old]"/>
                    </events>
                </eventscarousel>
                <weather
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="employeehub/components/weather"
                    heading="Weather at the Venue"
                    city="Bengaluru"/>
                <poll
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="employeehub/components/poll"
                    pollId="events-2026"
                    question="Which event are you most excited about?">
                    <options jcr:primaryType="nt:unstructured">
                        <item0 jcr:primaryType="nt:unstructured" label="Global Hackathon 2026"/>
                        <item1 jcr:primaryType="nt:unstructured" label="Leadership AMA Fireside"/>
                        <item2 jcr:primaryType="nt:unstructured" label="Monsoon Sports League"/>
                    </options>
                </poll>
            </main>
            <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="employeehub/components/footer"
                copyrightText="© 2026 Hashout Technologies. All rights reserved."/>
        </root>
    </jcr:content>
</jcr:root>
