<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Events Carousel"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <heading jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Section Heading"
                name="./heading"
                emptyText="Upcoming Events"/>
            <events jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                composite="{Boolean}true"
                fieldLabel="Events">
                <field jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/container"
                    name="./events">
                    <items jcr:primaryType="nt:unstructured">
                        <image jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                            fieldLabel="Event Image"
                            name="./image"
                            rootPath="/content/dam/employeehub"/>
                        <title jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Event Title"
                            name="./title"/>
                        <description jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                            fieldLabel="Event Description"
                            name="./description"/>
                        <eventDate jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                            fieldLabel="Event Date &amp; Time"
                            type="datetime"
                            displayedFormat="YYYY-MM-DD HH:mm"
                            valueFormat="YYYY-MM-DD[T]HH:mm:ss.SSSZ"
                            name="./eventDate"/>
                        <tags jcr:primaryType="nt:unstructured"
                            sling:resourceType="cq/gui/components/coral/common/form/tagfield"
                            fieldLabel="Event Tags"
                            name="./cq:tags"
                            multiple="{Boolean}true"
                            rootPath="/content/cq:tags/employeehub/event-type"/>
                    </items>
                </field>
            </events>
        </items>
    </content>
</jcr:root>
