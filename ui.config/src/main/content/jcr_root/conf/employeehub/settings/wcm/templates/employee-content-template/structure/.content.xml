<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        sling:resourceType="employeehub/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="wcm/foundation/components/responsivegrid"
            layout="responsiveGrid">
            <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="employeehub/components/header"/>
            <breadcrumb
                jcr:primaryType="nt:unstructured"
                sling:resourceType="employeehub/components/breadcrumb"/>
            <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="wcm/foundation/components/responsivegrid"
                cq:policy="employeehub/content-main"
                editable="{Boolean}true"
                layout="responsiveGrid"/>
            <footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="employeehub/components/footer"/>
        </root>
    </jcr:content>
</jcr:root>
